{
  "manifest_version": 3,
  "name": "Send Text to Background Tab",
  "version": "1.0",
  "description": "Sends text to an input field on a specific background tab.",
  "permissions": [
    "contextMenus",
    "tabs",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}